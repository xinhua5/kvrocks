
cmake_minimum_required(VERSION 3.15)

set(command "/usr/bin/cmake;-DCMAKE_BUILD_TYPE=Debug;-DCMAKE_INSTALL_LIBDIR=lib;-DCMAKE_INSTALL_PREFIX=/root/kvrocks/build/external/rocksdb-install;-DBUILD_SHARED_LIBS=OFF;-DBUILD_STATIC_LIBS=ON;-DBUILD_PACKAGING=OFF;-DBUILD_TESTING=OFF;-DBUILD_NC_TESTS=OFF;-DBUILD_CONFIG_TESTS=OFF;-DINSTALL_HEADERS=ON;-DCMAKE_C_FLAGS= -fPIC;-DCMAKE_CXX_FLAGS= -fPIC;-DCMAKE_PREFIX_PATH=/root/kvrocks/build/external/snappy-install;-DJEMALLOC_ROOT_DIR=/root/kvrocks/build/external/jemalloc-install;-DFAIL_ON_WARNINGS=OFF;-DWITH_TESTS=OFF;-DWITH_SNAPPY=ON;-DWITH_TOOLS=OFF;-DWITH_GFLAGS=OFF;-DUSE_RTTI=ON;-DWITH_JEMALLOC=ON;-GNinja;/root/kvrocks/external/rocksdb")
set(log_merged "")
set(log_output_on_failure "")
set(stdout_log "/root/kvrocks/build/external/rocksdb-prefix/src/rocksdb-stamp/rocksdb-configure-out.log")
set(stderr_log "/root/kvrocks/build/external/rocksdb-prefix/src/rocksdb-stamp/rocksdb-configure-err.log")
execute_process(
  COMMAND ${command}
  RESULT_VARIABLE result
  OUTPUT_FILE "${stdout_log}"
  ERROR_FILE "${stderr_log}"
  )
macro(read_up_to_max_size log_file output_var)
  file(SIZE ${log_file} determined_size)
  set(max_size 10240)
  if (determined_size GREATER max_size)
    math(EXPR seek_position "${determined_size} - ${max_size}")
    file(READ ${log_file} ${output_var} OFFSET ${seek_position})
    set(${output_var} "...skipping to end...\n${${output_var}}")
  else()
    file(READ ${log_file} ${output_var})
  endif()
endmacro()
if(result)
  set(msg "Command failed: ${result}\n")
  foreach(arg IN LISTS command)
    set(msg "${msg} '${arg}'")
  endforeach()
  if (${log_merged})
    set(msg "${msg}\nSee also\n  ${stderr_log}")
  else()
    set(msg "${msg}\nSee also\n  /root/kvrocks/build/external/rocksdb-prefix/src/rocksdb-stamp/rocksdb-configure-*.log")
  endif()
  if (${log_output_on_failure})
    message(SEND_ERROR "${msg}")
    if (${log_merged})
      read_up_to_max_size("${stderr_log}" error_log_contents)
      message(STATUS "Log output is:\n${error_log_contents}")
    else()
      read_up_to_max_size("${stdout_log}" out_log_contents)
      read_up_to_max_size("${stderr_log}" err_log_contents)
      message(STATUS "stdout output is:\n${out_log_contents}")
      message(STATUS "stderr output is:\n${err_log_contents}")
    endif()
    message(FATAL_ERROR "Stopping after outputting logs.")
  else()
    message(FATAL_ERROR "${msg}")
  endif()
else()
  if(NOT "Ninja" MATCHES "Ninja")
    set(msg "rocksdb configure command succeeded.  See also /root/kvrocks/build/external/rocksdb-prefix/src/rocksdb-stamp/rocksdb-configure-*.log")
    message(STATUS "${msg}")
  endif()
endif()
