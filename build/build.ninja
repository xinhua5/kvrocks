build kvrocks: CXX_EXECUTABLE_LINKER__kvrocks_Debug CMakeFiles/kvrocks.dir/src/cluster.cc.o CMakeFiles/kvrocks.dir/src/slot_migrate.cc.o CMakeFiles/kvrocks.dir/src/slot_import.cc.o CMakeFiles/kvrocks.dir/src/batch_extractor.cc.o CMakeFiles/kvrocks.dir/src/redis_db.cc.o CMakeFiles/kvrocks.dir/src/redis_connection.cc.o CMakeFiles/kvrocks.dir/src/compact_filter.cc.o CMakeFiles/kvrocks.dir/src/worker.cc.o CMakeFiles/kvrocks.dir/src/main.cc.o CMakeFiles/kvrocks.dir/src/redis_request.cc.o CMakeFiles/kvrocks.dir/src/redis_cmd.cc.o CMakeFiles/kvrocks.dir/src/util.cc.o CMakeFiles/kvrocks.dir/src/geohash.cc.o CMakeFiles/kvrocks.dir/src/storage.cc.o CMakeFiles/kvrocks.dir/src/redis_reply.cc.o CMakeFiles/kvrocks.dir/src/replication.cc.o CMakeFiles/kvrocks.dir/src/task_runner.cc.o CMakeFiles/kvrocks.dir/src/encoding.cc.o CMakeFiles/kvrocks.dir/src/redis_slot.cc.o CMakeFiles/kvrocks.dir/src/redis_metadata.cc.o CMakeFiles/kvrocks.dir/src/redis_string.cc.o CMakeFiles/kvrocks.dir/src/redis_hash.cc.o CMakeFiles/kvrocks.dir/src/redis_list.cc.o CMakeFiles/kvrocks.dir/src/redis_set.cc.o CMakeFiles/kvrocks.dir/src/redis_zset.cc.o CMakeFiles/kvrocks.dir/src/redis_geo.cc.o CMakeFiles/kvrocks.dir/src/redis_bitmap.cc.o CMakeFiles/kvrocks.dir/src/redis_bitmap_string.cc.o CMakeFiles/kvrocks.dir/src/redis_pubsub.cc.o CMakeFiles/kvrocks.dir/src/redis_sortedint.cc.o CMakeFiles/kvrocks.dir/src/lock_manager.cc.o CMakeFiles/kvrocks.dir/src/config.cc.o CMakeFiles/kvrocks.dir/src/stats.cc.o CMakeFiles/kvrocks.dir/src/server.cc.o CMakeFiles/kvrocks.dir/src/cron.cc.o CMakeFiles/kvrocks.dir/src/event_listener.cc.o CMakeFiles/kvrocks.dir/src/log_collector.cc.o CMakeFiles/kvrocks.dir/src/table_properties_collector.cc.o CMakeFiles/kvrocks.dir/src/compaction_checker.cc.o CMakeFiles/kvrocks.dir/src/scripting.cc.o CMakeFiles/kvrocks.dir/src/sha1.cc.o CMakeFiles/kvrocks.dir/src/rand.cc.o | external/jemalloc-install/lib/libjemalloc.a external/glog-install/lib/libglog.a external/rocksdb-install/lib/librocksdb.a external/snappy-install/lib/libsnappy.a external/libevent-install/lib/libevent.a external/libevent-install/lib/libevent_pthreads.a external/lua-install/liblua.a external/jemalloc-install/lib/libjemalloc.a external/glog-install/lib/libglog.a external/rocksdb-install/lib/librocksdb.a external/snappy-install/lib/libsnappy.a external/libevent-install/lib/libevent.a external/libevent-install/lib/libevent_pthreads.a external/lua-install/liblua.a || glog jemalloc libevent lua rocksdb snappy
  FLAGS = -g
  LINK_FLAGS = -static-libgcc -static-libstdc++
  LINK_LIBRARIES = -lpthread  -fno-omit-frame-pointer  -lrt  external/jemalloc-install/lib/libjemalloc.a  -lpthread  external/glog-install/lib/libglog.a  external/rocksdb-install/lib/librocksdb.a  external/snappy-install/lib/libsnappy.a  external/libevent-install/lib/libevent.a  external/libevent-install/lib/libevent_pthreads.a  external/lua-install/liblua.a  -lrt  external/jemalloc-install/lib/libjemalloc.a  external/glog-install/lib/libglog.a  external/rocksdb-install/lib/librocksdb.a  external/snappy-install/lib/libsnappy.a  external/libevent-install/lib/libevent.a  external/libevent-install/lib/libevent_pthreads.a  external/lua-install/liblua.a
  OBJECT_DIR = CMakeFiles/kvrocks.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = kvrocks
  TARGET_PDB = kvrocks.dbg


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /root/kvrocks/build && /usr/bin/cmake --regenerate-during-build -S/root/kvrocks -B/root/kvrocks/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


